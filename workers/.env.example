# Copy to workers/.env and fill. Never commit real secrets.
# Workers (webhook processing, reconciliation) run the same async jobs as the control plane.

# --- queue (at-least-once; consumers are idempotent) ---
SQS_URL=http://localhost:4566/000000000000/aegispay

# --- database (read the same tenant-isolated Postgres as the control plane) ---
DATABASE_URL=postgresql+asyncpg://aegispay_app:aegispay@localhost:5433/aegispay

# --- razorpay (webhook/reconciliation need to verify + reconcile; server-side only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
