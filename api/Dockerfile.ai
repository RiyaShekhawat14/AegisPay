FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_DEFAULT_TIMEOUT=120 PIP_DISABLE_PIP_VERSION_CHECK=1

# Build context = repo root. The AI runtime is a top-level package for this image.
COPY api/pyproject.toml ./
COPY api/ai_runtime ./ai_runtime
RUN pip install --no-cache-dir --timeout 120 .

EXPOSE 8000
CMD ["uvicorn", "ai_runtime.main:app", "--host", "0.0.0.0", "--port", "8000"]
