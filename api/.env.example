# Copy to .env and fill. Never commit real secrets.
# --- application ---
APP_ENV=local
LOG_LEVEL=info

# --- database (control plane only; never given to the AI runtime) ---
# Host port 5433 -> Docker Postgres (5432). Local port 5432 is often taken by a
# native Postgres; 5433 keeps the Docker DB reachable without a clash.
DATABASE_URL=postgresql+asyncpg://aegispay_app:aegispay@localhost:5433/aegispay
DATABASE_MIGRATION_URL=postgresql+asyncpg://aegispay_migration:aegispay@localhost:5433/aegispay

# --- redis (cache / locks / rate; never the source of truth) ---
REDIS_URL=redis://localhost:6379/0

# --- queue ---
SQS_URL=http://localhost:4566/000000000000/aegispay

# --- AI runtime -> control plane (isolated service) ---
# The AI Runtime talks to the control plane over HTTP ONLY. It has NO database
# credentials and NO payment secrets. Leave DATABASE_URL above out of its image.
CONTROL_PLANE_URL=http://localhost:8000
CONTROL_PLANE_TOKEN=

# --- razorpay (test keys; secret stays server-side only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# --- auth ---
JWT_SECRET=change-me
OIDC_ISSUER=

# --- encryption (KMS envelope key for sensitive fields) ---
FIELD_ENC_KEY=

# --- observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
